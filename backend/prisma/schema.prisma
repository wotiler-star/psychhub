// 心理学聚合平台 · 数据模型（Prisma + SQLite）
// 说明：生产环境原定 PostgreSQL；因轻量服务器(2GB)内存紧张且无 PG，
// 现改用 SQLite（零额外进程、最省内存）。枚举与标量数组在 SQLite 不支持，
// 已做兼容：type 退化为 String；tags/specialties/approach/languages 用 Json 存储（Prisma 自动收发数组）。
// 覆盖三期实体：资源导航 / 求助资源 / 测评 / 心理资讯 / 咨询师目录 / 咨询师评价 / 账号用户

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Resource {
  id           String       @id @default(cuid())
  name         String
  url          String
  type         String
  country      String?
  language     String?
  description  String?
  trafficLevel String? // 量级描述，如 "2330万/月"
  suitableFor  String?
  tags         String // 数组以 "|a|b|" 形式存储，经 Prisma 扩展还原为数组
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([type])
  @@index([country])
  @@index([featured])
  @@unique([name])
}

model Helpline {
  id          String   @id @default(cuid())
  name        String
  country     String
  language    String
  phone       String?
  url         String?
  description String?
  category    String? // CRISIS / SUPPORT / LOW_COST
  createdAt   DateTime @default(now())

  @@index([country])
  @@index([language])
  @@unique([name])
}

model Assessment {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?
  type          String? // DEPRESSION / ANXIETY / PERSONALITY
  questions     String // JSON 字符串，经 Prisma 扩展还原为对象数组
  interpretation String? // JSON 字符串，经 Prisma 扩展还原为对象
  source        String? // 量表来源与版权说明
  createdAt     DateTime @default(now())
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String? // 摘要
  content     String // 正文（纯文本，按段落分隔）
  category    String? // POPSCI 科普 / RESEARCH 研究 / NEWS 资讯
  tags        String // 数组以 "|a|b|" 形式存储，经 Prisma 扩展还原为数组
  sourceName  String? // 来源站点/作者
  sourceUrl   String? // 原文链接
  author      String?
  coverImage  String? // 封面图（可选）
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
}

// 咨询师 / 执业者目录（三期「转介层」核心实体）
model Counselor {
  id              String   @id @default(cuid())
  name            String
  title           String?
  specialties     String // 擅长议题（"|抑郁|焦虑|"，经 Prisma 扩展还原为数组）
  approach        String // 取向/流派（"|CBT|..."，经 Prisma 扩展还原为数组）
  region          String? // 所在地区（含「远程（全国）」「海外（北美）」等）
  remote          Boolean  @default(false)
  languages       String // 语言（"|中文|英文|"，经 Prisma 扩展还原为数组）
  pricePerSession Int? // 单次参考价（人民币）
  currency        String   @default("CNY")
  org             String? // 所属机构 / 平台
  bio             String?
  avatar          String?
  bookingUrl      String? // 外部预约入口（转介）
  rating          Float? // 参考评分
  yearsExperience Int? // 从业年限
  tags            String // 标签（"|a|b|"，经 Prisma 扩展还原为数组）
  featured        Boolean  @default(false)
  reviews         Review[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([region])
  @@index([featured])
  @@unique([name])
}

// 咨询师评价 / 社区 UGC（三期「社区 + 咨询师评价」核心实体）
model Review {
  id          String    @id @default(cuid())
  counselorId String
  counselor   Counselor @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  authorName  String
  authorId    String?
  rating      Int // 1-5 星
  content     String
  status      String    @default("PUBLISHED") // PUBLISHED / HIDDEN（审核 / 合规）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([counselorId])
  @@index([createdAt])
}

// 账号 / 用户（三期「账号体系」核心实体）
// 密码以 bcrypt 哈希存储，绝不落明文；JWT 仅含非敏感字段（id/email/name/role）
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("USER") // USER / ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}
