# 后端环境变量示例（复制为 .env，严禁提交真实密钥 R6.4 / R12）
# ── 运行模式 ──
# 生产必填：production 触发「Swagger 关闭 + 严格 CSP + HSTS」；留空/development 则开放 Swagger、关闭 CSP
NODE_ENV="production"

# ── 数据库（本地开发 = SQLite；生产 = Hostinger MySQL/MariaDB）──
# 本地开发（默认 schema.prisma / SQLite）：
#   DATABASE_URL="file:./dev.db"
# 生产（Hostinger MySQL/MariaDB）：在 hPanel「数据库」中创建，复制其连接信息。
#   host 形如 mysql.hostinger.com 或专属主机名；port 通常 3306。
#   ⚠️ 必须先在 hPanel「Remote MySQL」把后端服务器出口 IP 加入白名单（本项目后端位于
#      腾讯云轻量 175.178.23.30），否则跨网连接会被拒绝（ECONNREFUSED / 超时）。
#   connection_limit 控制连接池上限（共享型 MySQL 建议 5~10）。
DATABASE_URL="mysql://DBUSER:DBPASS@mysql.hostinger.com:3306/DBNAME?connection_limit=10&pool_timeout=20"
PORT=3501

# ── 鉴权 ──
# 生产环境务必替换为强随机值（用于签发用户 JWT，建议 32+ 位随机串）
JWT_SECRET="change-me-in-production"

# ── CORS 白名单 ──
# 生产必填：允许携带凭据跨源调用本 API 的前端源（逗号分隔）。
# 例：https://psychhub.example.com,https://www.psychhub.example.com
# 缺省仅放行 http://localhost:3400（本地预览），生产不配置会导致前端跨域被拒
ALLOWED_ORIGINS="https://psychhub.example.com"

# ── docker compose 用：PostgreSQL 凭据（与 compose 中的 db 服务一致） ──
POSTGRES_USER="psych"
POSTGRES_PASSWORD="psych_pass"
POSTGRES_DB="psychhub"
